# Scraper service environment variables
# Copy this file to .env.scraper and fill in your values.
# NEVER commit .env.scraper to git.

# Discount Bank credentials
# id = national ID number (ת.ז.)
# password = online banking password
# num = access code shown on the login page (קוד גישה)
DISCOUNT_BANK_USERNAME=your_national_id
DISCOUNT_BANK_PASSWORD=your_discount_bank_password
DISCOUNT_BANK_NUM=your_access_code

# Supabase (use the SERVICE ROLE key — not the anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: API key to protect the scraper service from unauthorized callers
# If left empty, any caller can trigger an import (fine for local dev only).
SCRAPER_API_KEY=

PORT=3001
