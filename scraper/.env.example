# Scraper service environment variables
# Copy this file to scraper/.env.scraper and fill in your values.
# NEVER commit .env.scraper to git.

# Supabase (use the SERVICE ROLE key — not the anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption key for storing bank credentials in Supabase.
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes).
ENCRYPTION_KEY=your_64_hex_char_encryption_key_here

# Optional: API key to protect the scraper service from unauthorized callers.
# If left empty, any caller can trigger an import (fine for local dev only).
SCRAPER_API_KEY=

PORT=3001
