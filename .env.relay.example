# Ooga local relay configuration
# Copy this file to .env.relay and fill in the values.
# Run the relay with: node --env-file=.env.relay relay.js
#
# These are the same values set in your Vercel environment variables.
# Find them in: Vercel dashboard → your project → Settings → Environment Variables

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: change port if 9191 is in use
# RELAY_PORT=9191
