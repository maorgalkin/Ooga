# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (for email verification links)
# In production (Vercel), set this to your deployed URL
# Example: https://your-app.vercel.app
VITE_SITE_URL=http://localhost:5173

# Bank Import — scraper microservice URL
# For local dev (docker-compose): http://localhost:3001
# For production: https://your-scraper-service.railway.app
VITE_SCRAPER_SERVICE_URL=http://localhost:3001

# Optional: API key matching SCRAPER_API_KEY in the scraper service
VITE_SCRAPER_API_KEY=
