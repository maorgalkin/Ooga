# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (for email verification links)
# In production (Cloudflare Pages), set this to your deployed URL
# Example: https://haooga.com
VITE_SITE_URL=http://localhost:5173

# Import service (scraper/) used for bank accounts that can't be imported from the browser,
# e.g. Discount Bank. Defaults to https://api.haooga.com
# VITE_SCRAPER_URL=http://localhost:3001
