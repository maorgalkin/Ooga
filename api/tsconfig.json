{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": ".vercel/output/functions/api",
    "resolveJsonModule": true,
    "noEmit": false
  },
  "include": ["./**/*.ts"]
}
